{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orcave",
  "version": "0.2.0-alpha",
  "identifier": "com.orcave.orcave",
  "build": {
    "beforeDevCommand": null,
    "devUrl": null,
    "beforeBuildCommand": "npm --prefix ../frontend-tauri run build",
    "frontendDist": "../../frontend-tauri/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orcave 2.0 Alpha",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "startMenuFolder": "Orcave"
      }
    }
  },
  "plugins": {
    "store": null,
    "updater": {
      "active": false
    }
  }
}